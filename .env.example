# Supabase project (from `supabase status` locally, or the project settings in production)
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_SERVICE_ROLE_KEY=

# Static bearer token the Shortcut sends on every ingest call
INGEST_TOKEN=

# OpenRouter: API key and the model id used for every analysis (a Gemini Flash-class model)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Firecrawl: API key used to read web pages as Markdown (free tier covers hundreds of pages a month)
FIRECRAWL_API_KEY=

# Apify: API token and the Instagram scraper actor (owner~name) used to read posts and Reels
APIFY_TOKEN=
APIFY_ACTOR=apify~instagram-scraper

# Vercel Cron sends this as a bearer token when it invokes the cron routes
CRON_SECRET=

# Resend: API key and the verified sender of the Digest (the Owner's domain)
RESEND_API_KEY=
DIGEST_FROM=Zapisane <digest@example.com>

# Public URL of the Panel, used for links to Uploads in the Digest
PANEL_URL=http://localhost:3000

# Supabase anon key: the Panel's cookie-based session client uses it (from `supabase status -o env` locally)
SUPABASE_ANON_KEY=

# The one Google account allowed into the Panel
OWNER_EMAIL=
