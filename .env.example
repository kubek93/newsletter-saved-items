# Copy to .env.local for `pnpm dev`. Every variable is required; the app refuses to start without one.
# Production values live in Vercel (Settings → Environment Variables), not in this repo.

# --- Supabase (Postgres, Auth, Storage) ---------------------------------------------------------
# Locally: `supabase start`, then `supabase status -o env`. Production: the project's API settings.
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Panel -------------------------------------------------------------------------------------
# Public URL of the Panel; also used for the Digest's links to Uploads and for the sign-in redirect.
PANEL_URL=http://localhost:3000
# The one account allowed into the Panel (email and password in Supabase Auth; Google later).
OWNER_EMAIL=

# --- Ingest (the Apple Shortcut) ---------------------------------------------------------------
# Static bearer token the Shortcut sends on every call. Any long random string, e.g. `openssl rand -hex 16`.
INGEST_TOKEN=

# --- Analysis --------------------------------------------------------------------------------
# OpenRouter: API key and the model used for every Summary (a Gemini Flash-class model; YouTube needs Google AI Studio).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# --- Readers ---------------------------------------------------------------------------------
# Firecrawl: web pages as Markdown (free tier at firecrawl.dev).
FIRECRAWL_API_KEY=
# Apify: Instagram posts and Reels through the scraper actor `owner~name` (paid per result).
APIFY_TOKEN=
APIFY_ACTOR=apify~instagram-scraper

# --- Digest ----------------------------------------------------------------------------------
# Resend: API key and the sender, which must be an address on a domain verified in Resend.
RESEND_API_KEY=
DIGEST_FROM=Zapisane <digest@example.com>

# --- Cron ------------------------------------------------------------------------------------
# Vercel Cron sends this as a bearer token to /api/cron/*. Any long random string, e.g. `openssl rand -hex 32`.
CRON_SECRET=
