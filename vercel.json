{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "fra1"
  ],
  "ignoreCommand": "[ \"$VERCEL_ENV\" = \"production\" ] && exit 1 || exit 0",
  "crons": [
    {
      "path": "/api/cron/retry",
      "schedule": "0 4,5 * * *"
    },
    {
      "path": "/api/cron/digest",
      "schedule": "0 5,6 * * *"
    }
  ]
}
